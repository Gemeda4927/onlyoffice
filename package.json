
{
  "name": "onlyoffice-proj",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "ports:free": "lsof -ti:3000,3001 2>/dev/null | xargs kill -9 2>/dev/null || true",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "npm run ports:free && concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f onlyoffice-documentserver"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
